index 00000000..6d2246f3
--- /dev/null
+++ b/test/unit/orders/lis-sample-direct.service.spec.ts
@@ -0,0 +1,304 @@
+import axios from 'axios';
+import * as jwt from 'jsonwebtoken';
+import { of, throwError } from 'rxjs';
+import {
+  LisSampleDirectService,
+  PNS_JWT_LIFETIME_S,
+  QNR_REQUIRED_MAP_CACHE_TTL_S,
+  QNR_REQUIRED_MAP_TIMEOUT_MS,
+} from '../../../src/orders/lis-sample-direct/lis-sample-direct.service';
+import {
+  LIS_SAMPLE_MODE_ENV,
+  resolveLisSampleMode,
+} from '../../../src/orders/lis-sample-direct/lis-sample-mode';
+import {
+  compareShadow,
+  runSide,
+} from '../../../src/orders/lis-sample-direct/shadow';
+import { HORMONE_RELATED_LAB_TEST_IDS } from '../../../src/orders/orders.constants';
+
+jest.mock('../../../src/utils/oauth2.client', () => ({
+  getOAuth2Token: jest.fn().mockResolvedValue('Bearer oauth2-token'),
+}));
+
+const SECRET = 'unit-test-secret';
+const HORMONE_TEST_ID = HORMONE_RELATED_LAB_TEST_IDS[0];
+
+function makeService(overrides: {
+  cache?: Partial<{ get: jest.Mock; set: jest.Mock }>;
+  grpc?: { getTestsResultsRelatedData: jest.Mock } | null;
+}) {
+  const cache = {
+    get: jest.fn().mockResolvedValue(undefined),
+    set: jest.fn().mockResolvedValue(undefined),
+    ...overrides.cache,
+  };
+  const grpcService = overrides.grpc;
+  const client =
+    grpcService === null
+      ? undefined
+      : {
+          getService: jest
+            .fn()
+            .mockReturnValue(
+              grpcService ?? { getTestsResultsRelatedData: jest.fn() },
+            ),
+        };
+  const service = new LisSampleDirectService(
+    cache as never,
+    SECRET,
+    client as never,
+  );
+  service.onModuleInit();
+  return { service, cache, client };
+}
+
+describe('resolveLisSampleMode (VP-18796)', () => {
+  afterEach(() => {
+    delete process.env[LIS_SAMPLE_MODE_ENV];
+  });
+
+  it.each([
+    [undefined, 'http'],
+    ['', 'http'],
+    ['http', 'http'],
+    ['shadow', 'shadow'],
+    [' DIRECT ', 'direct'],
+    ['on', 'http'],
+  ])('maps %p to %p', (raw, expected) => {
+    expect(resolveLisSampleMode(raw as string | undefined)).toBe(expected);
+  });
+
+  it('reads the environment when no argument is given', () => {
+    process.env[LIS_SAMPLE_MODE_ENV] = 'shadow';
+    expect(resolveLisSampleMode()).toBe('shadow');
+  });
+});
+
+describe('compareShadow (three-state)', () => {
+  it('separates failures from divergence', async () => {
+    const ok = await runSide(async () => true);
+    const other = await runSide(async () => false);
+    const failed = await runSide(async () => {
+      throw new Error('boom');
+    });
+    expect(compareShadow(ok, ok)).toBe('equal');
+    expect(compareShadow(ok, other)).toBe('differ');
+    expect(compareShadow(failed, failed)).toBe('both_failed');
+    expect(compareShadow(failed, ok)).toBe('old_failed');
+    expect(compareShadow(ok, failed)).toBe('new_failed');
+    expect(failed.reason).toBe('boom');
+  });
+});
+
+describe('LisSampleDirectService.resolve', () => {
+  afterEach(() => {
+    delete process.env[LIS_SAMPLE_MODE_ENV];
+  });
+
+  it('http mode calls only the LIS-Sample path', async () => {
+    const { service } = makeService({});
+    const old = jest.fn().mockResolvedValue(true);
+    const direct = jest.fn().mockResolvedValue(false);
+    await expect(
+      service.resolve({ name: 'x', sampleId: '1', old, direct }),
+    ).resolves.toBe(true);
+    expect(direct).not.toHaveBeenCalled();
+  });
+
+  it('shadow mode runs both, answers with the old value and logs the outcome', async () => {
+    process.env[LIS_SAMPLE_MODE_ENV] = 'shadow';
+    const { service } = makeService({});
+    const logSpy = jest
+      .spyOn((service as any).logger, 'log')
+      .mockImplementation(() => undefined);
+    const old = jest.fn().mockResolvedValue(true);
+    const direct = jest.fn().mockResolvedValue(false);
+    await expect(
+      service.resolve({
+        name: 'contains_hormones',
+        sampleId: '7',
+        old,
+        direct,
+      }),
+    ).resolves.toBe(true);
+    expect(direct).toHaveBeenCalledTimes(1);
+    const line = JSON.parse(logSpy.mock.calls[0][0] as string);
+    expect(line).toMatchObject({
+      event: 'lis_sample_shadow',
+      name: 'contains_hormones',
+      sample_id: '7',
+      outcome: 'differ',
+      old_value: true,
+      new_value: false,
+    });
+  });
+
+  it('shadow mode re-throws the old error so behaviour is unchanged', async () => {
+    process.env[LIS_SAMPLE_MODE_ENV] = 'shadow';
+    const { service } = makeService({});
+    jest
+      .spyOn((service as any).logger, 'log')
+      .mockImplementation(() => undefined);
+    const old = jest.fn().mockRejectedValue(new Error('lis-sample down'));
+    const direct = jest.fn().mockResolvedValue(true);
+    await expect(
+      service.resolve({ name: 'x', sampleId: '1', old, direct }),
+    ).rejects.toThrow('lis-sample down');
+  });
+
+  it('direct mode never calls LIS-Sample and applies the fallback on failure', async () => {
+    process.env[LIS_SAMPLE_MODE_ENV] = 'direct';
+    const { service } = makeService({});
+    jest
+      .spyOn((service as any).logger, 'warn')
+      .mockImplementation(() => undefined);
+    const old = jest.fn().mockResolvedValue(true);
+    const direct = jest.fn().mockRejectedValue(new Error('order-service 503'));
+    await expect(
+      service.resolve({
+        name: 'x',
+        sampleId: '1',
+        old,
+        direct,
+        onDirectError: () => false,
+      }),
+    ).resolves.toBe(false);
+    expect(old).not.toHaveBeenCalled();
+    await expect(
+      service.resolve({ name: 'x', sampleId: '1', old, direct }),
+    ).rejects.toThrow('order-service 503');
+  });
+});
+
+describe('LisSampleDirectService.containsHormones', () => {
+  const axiosGet = jest.spyOn(axios, 'get');
+
+  beforeEach(() => {
+    axiosGet.mockReset();
+    process.env.LIS_ORDER_HTTP_URL = 'https://order.example/';
+    process.env.LIS_TOKEN = 'lis-token';
+  });
+
+  it('fetches the questionnaire map with a 3 s timeout and caches it for five minutes', async () => {
+    const { service, cache } = makeService({});
+    axiosGet.mockResolvedValue({
+      status: 200,
+      data: { has_hormone_questionnaire: true, has_gut_zoomer: false },
+    });
+    await expect(service.containsHormones('123')).resolves.toBe(true);
+    expect(axiosGet).toHaveBeenCalledWith(
+      'https://order.example/orderTest/getQuestionnaireRequiredMap?sampleId=123',
+      expect.objectContaining({ timeout: QNR_REQUIRED_MAP_TIMEOUT_MS }),
+    );
+    expect(cache.set).toHaveBeenCalledWith(
+      expect.stringContaining('lis-sample-direct:qnr-required-map:123'),
+      { has_hormone_questionnaire: true, has_gut_zoomer: false },
+      { ttl: QNR_REQUIRED_MAP_CACHE_TTL_S },
+    );
+  });
+
+  it('answers from the cache without calling order-service', async () => {
+    const { service } = makeService({
+      cache: {
+        get: jest.fn().mockResolvedValue({ has_hormone_questionnaire: false }),
+      },
+    });
+    await expect(service.containsHormones('123')).resolves.toBe(false);
+    expect(axiosGet).not.toHaveBeenCalled();
+  });
+
+  it('is false when the map has no hormone flag and throws when the fetch fails', async () => {
+    const { service } = makeService({});
+    axiosGet.mockResolvedValueOnce({ status: 200, data: {} });
+    await expect(service.containsHormones('1')).resolves.toBe(false);
+    axiosGet.mockRejectedValueOnce(new Error('timeout of 3000ms exceeded'));
+    await expect(service.containsHormones('2')).rejects.toThrow('timeout');
+  });
+});
+
+describe('LisSampleDirectService.hormoneTestApproved', () => {
+  it('is true only when a hormone-related test is approved, last entry wins', async () => {
+    const grpc = {
+      getTestsResultsRelatedData: jest.fn().mockReturnValue(
+        of({
+          testInfo: [
+            { testId: HORMONE_TEST_ID, status: 'approved' },
+            { testId: HORMONE_TEST_ID, status: 'pending' },
+            { testId: 1, status: 'approved' },
+          ],
+        }),
+      ),
+    };
+    const { service } = makeService({ grpc });
+    await expect(service.hormoneTestApproved('55')).resolves.toBe(false);
+    expect(grpc.getTestsResultsRelatedData).toHaveBeenCalledWith({
+      sampleId: 55,
+    });
+
+    grpc.getTestsResultsRelatedData.mockReturnValue(
+      of({ testInfo: [{ testId: HORMONE_TEST_ID, status: 'approved' }] }),
+    );
+    await expect(service.hormoneTestApproved('55')).resolves.toBe(true);
+
+    grpc.getTestsResultsRelatedData.mockReturnValue(of({}));
+    await expect(service.hormoneTestApproved('55')).resolves.toBe(false);
+  });
+
+  it('throws on gRPC failure and when the client is not configured', async () => {
+    const grpc = {
+      getTestsResultsRelatedData: jest
+        .fn()
+        .mockReturnValue(throwError(() => new Error('14 UNAVAILABLE'))),
+    };
+    const { service } = makeService({ grpc });
+    await expect(service.hormoneTestApproved('55')).rejects.toThrow(
+      'UNAVAILABLE',
+    );
+    const { service: unconfigured } = makeService({ grpc: null });
+    await expect(unconfigured.hormoneTestApproved('55')).rejects.toThrow(
+      'not configured',
+    );
+  });
+});
+
+describe('LisSampleDirectService pns_jwt', () => {
+  it('mints the token LIS-Sample minted: HS256, six hours, ids || null', () => {
+    const { service } = makeService({});
+    const now = 1_791_900_000_000;
+    const token = service.mintPnsJwt(
+      { patient_id: 42, customer_id: 7, clinic_id: 0 },
+      now,
+    );
+    const claims = jwt.verify(token, SECRET, {
+      algorithms: ['HS256'],
+    }) as Record<string, unknown>;
+    expect(claims).toEqual({
+      patient_id: 42,
+      customer_id: 7,
+      clinic_id: null,
+      role: 'patient',
+      internal_user_role: 'admin',
+      iat: Math.floor(now / 1000),
+      exp: Math.floor(now / 1000) + PNS_JWT_LIFETIME_S,
+    });
+  });
+
+  it('compares identity claims and lifetime, never the raw token', () => {
+    const { service } = makeService({});
+    const ids = { patient_id: 42, customer_id: 7, clinic_id: 9 };
+    const a = service.mintPnsJwt(ids, 1_791_900_000_000);
+    const b = service.mintPnsJwt(ids, 1_791_900_120_000);
+    const c = service.mintPnsJwt({ ...ids, clinic_id: 10 }, 1_791_900_000_000);
+    expect(a).not.toBe(b);
+    expect(service.pnsJwtClaimsEqual(a, b)).toBe(true);
+    expect(service.pnsJwtClaimsEqual(a, c)).toBe(false);
+    expect(service.pnsJwtClaimsEqual('not-a-jwt', a)).toBe(false);
+    expect(service.describePnsJwt(a)).toEqual({
+      ...ids,
+      role: 'patient',
+      internal_user_role: 'admin',
+      lifetime_s: PNS_JWT_LIFETIME_S,
+    });
+  });
+});
