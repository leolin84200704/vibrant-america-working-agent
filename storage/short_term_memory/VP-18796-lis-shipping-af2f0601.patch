+syntax = "proto3";
+
+import "google/protobuf/empty.proto";
+import "google/protobuf/timestamp.proto";
+package testresult;
+
+service TestResultInfoGrpcService{
+    rpc getTestsResultsRelatedData (TestsOneInfo) returns (TestResultDataMsg) {};
+    rpc getTestsDataByTestCodeBatch (TestsInfoByTestCode) returns (TestResultDataMsgs) {}
+    rpc getTestsRedrawData (TestsOneInfo) returns (TestRedrawDataMsg) {};
+
+    rpc getTubeTnpTestList (TestsBasicOneInfo) returns (TnpTestListMsg) {};
+    rpc validateManualResult(ManualResults) returns (ValidatedResponses){};
+
+    rpc getIndexTestResultData(SamplesInfo) returns (IndexTestResultDataMsg){};
+}
+
+message TestsInfo{
+    repeated TestsOneInfo info = 1;
+}
+
+message TestsOneInfo{
+    optional int32 sampleId = 1;
+    optional string barcodeTubeId = 2;
+    repeated int32 testIds = 3;
+}
+
+message TestsInfoByTestCode{
+    repeated TestsOneInfoByTestCode info = 1;
+}
+
+message TestsOneInfoByTestCode {
+    optional int32 sampleId = 1;
+    optional string barcodeTubeId = 2;
+    repeated string testCodes = 3;
+}
+
+message TestResultDataMsgs{
+    repeated TestResultDataMsg results = 1;
+}
+
+message TestResultDataMsg{
+    int32 sampleId = 1;
+    string barcodeTubeId = 2;
+    string patientId = 3;
+    repeated TestResultDetailDataMsg testInfo = 4;
+}
+
+message TestResultDetailDataMsg{
+    int32 testId = 1;
+    string testCode = 2;
+    string testName = 3;
+    string sampleType = 4;
+    string instrument = 5;
+    string instrumentId = 6;
+    string resultComeFrom = 7;
+    string rawResult = 8;
+    string simpleParsedResult = 9;
+    int32 masterlistId = 11;
+    string resultStatus = 12;
+    string approvedBy = 13;
+    string sampleCollectionTime = 14;
+    string receiveTime = 15;
+    string finished = 16;
+    string approved = 17;
+    string status = 18;
+    string color = 19;
+    string referenceId = 20;
+    string turnaroundDays = 21;
+}
+
+message TestRedrawDataMsg{
+    int32 sampleId = 1;
+    string barcodeTubeId = 2;
+    string patientId = 3;
+    repeated TestRedrawDetailDataMsg testInfo = 4;
+}
+
+message TestRedrawDetailDataMsg{
+    int32 testId = 1;
+    string testCode = 2;
+    string testName = 3;
+    string sampleType = 4;
+    string instrument = 5;
+    string instrumentId = 6;
+    string resultComeFrom = 7;
+    string rawResult = 8;
+    string simpleParsedResult = 9;
+    int32 masterlistId = 11;
+    string resultStatus = 12;
+    string approvedBy = 13;
+    string sampleCollectionTime = 14;
+    string receiveTime = 15;
+    string finished = 16;
+    string approved = 17;
+    string status = 18;
+    bool ifPreviouslyRedrawn = 19;
+    string turnaroundDays = 20;
+}
+
+message TnpTestListMsg{
+    repeated int32 tnpTestList = 1;
+}
+
+message TestsBasicOneInfo{
+    optional int32 sampleId = 1;
+    optional string barcodeTubeId = 2;
+}
+message ManualResults{
+    repeated ManualResult results = 1;
+}
+
+message ManualResult{
+    int32 sampleId = 1;
+    int32 testId = 2;
+    string result = 3;
+}
+
+message ValidatedResponses {
+    repeated ValidatedResponse parsedResults = 1;
+    repeated ValidatedResponse invalidResults = 2;
+}
+
+message ValidatedResponse {
+    int32 sampleId = 1;
+    int32 testId = 2;
+    string result = 3;
+}
+
+message IndexTestResultDataMsg {
+    repeated IndexTestResultDetailDataMsg results = 1;
+}
+
+message IndexTestResultDetailDataMsg {
+    int32 sampleId = 1;
+    string barcodeTubeId = 2;
+    repeated IndexTestResultDetailData testInfo = 3;
+}
+
+message IndexTestResultDetailData {
+    string testCode = 1;
+    string testName = 2;
+    string instrument = 3;
+    string instrumentId = 4;
+    string rawResult = 5;
+    string finished = 6;
+}
+
+message SamplesInfo {
+    repeated int32 sampleIds = 1;
+    repeated string barcodeTubeIds = 2;
+}
+
+
