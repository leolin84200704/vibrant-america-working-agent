@@ -0,0 +1,52 @@
+/**
+ * Three-state shadow comparison (same shape as trans v1 `src/common/shadow.ts`,
+ * VP-18459). A failure on one side is never reported as `differ`: a shared
+ * downstream outage would otherwise look like a cutover blocker, and a
+ * comparator that counts failures as equal would hide real divergence.
+ */
+export type ShadowOutcome =
+  | 'equal'
+  | 'differ'
+  | 'both_failed'
+  | 'old_failed'
+  | 'new_failed';
+
+export interface ShadowSide<T> {
+  ok: boolean;
+  value?: T;
+  error?: unknown;
+  reason?: string;
+  ms: number;
+}
+
+export async function runSide<T>(fn: () => Promise<T>): Promise<ShadowSide<T>> {
+  const startedAt = Date.now();
+  try {
+    const value = await fn();
+    return { ok: true, value, ms: Date.now() - startedAt };
+  } catch (error) {
+    return {
+      ok: false,
+      error,
+      reason: error instanceof Error ? error.message : String(error),
+      ms: Date.now() - startedAt,
+    };
+  }
+}
+
+export function compareShadow<T>(
+  oldSide: ShadowSide<T>,
+  newSide: ShadowSide<T>,
+  equals: (a: T, b: T) => boolean = (a, b) => a === b,
+): ShadowOutcome {
+  if (!oldSide.ok && !newSide.ok) {
+    return 'both_failed';
+  }
+  if (!oldSide.ok) {
+    return 'old_failed';
+  }
+  if (!newSide.ok) {
+    return 'new_failed';
+  }
+  return equals(oldSide.value as T, newSide.value as T) ? 'equal' : 'differ';
+}
