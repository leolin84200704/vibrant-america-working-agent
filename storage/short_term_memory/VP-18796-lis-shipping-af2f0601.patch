index 00000000..3d7c8bf4
--- /dev/null
+++ b/src/orders/lis-sample-direct/lis-sample-direct.service.ts
@@ -0,0 +1,305 @@
+import {
+  CACHE_MANAGER,
+  Inject,
+  Injectable,
+  Logger,
+  OnModuleInit,
+  Optional,
+} from '@nestjs/common';
+import { ClientGrpc } from '@nestjs/microservices';
+import { Cache } from 'cache-manager';
+import axios from 'axios';
+import * as jwt from 'jsonwebtoken';
+import { lastValueFrom, Observable } from 'rxjs';
+import { getOAuth2Token } from '../../utils/oauth2.client';
+import { redisKey } from '../../redis/redis-key.util';
+import { HORMONE_RELATED_LAB_TEST_IDS } from '../orders.constants';
+import { resolveLisSampleMode } from './lis-sample-mode';
+import { compareShadow, runSide, ShadowOutcome } from './shadow';
+
+/**
+ * VP-18796: the three values LIS-Shipping used to fetch from LIS-Sample, read
+ * from their sources instead. Each LIS-Sample route only ever contributed one
+ * field to Shipping:
+ *
+ * - `GET /patients/orders/operation-settings` -> `contains_hormones`, which
+ *   LIS-Sample derives from order-service
+ *   `orderTest/getQuestionnaireRequiredMap`.`has_hormone_questionnaire`
+ *   (a 5-minute cache in front, 3 s timeout, false on failure).
+ * - `GET /tests` -> whether a hormone-related test is `approved`; that status
+ *   comes only from results-grpc `getTestsResultsRelatedData`.
+ * - `GET /patients/pns-jwt` -> an HS256 token signed with the same
+ *   AUTH_JWT_SECRET this service already holds.
+ *
+ * `resolve()` applies SHIPPING_LIS_SAMPLE_MODE (http / shadow / direct).
+ */
+
+export const QNR_REQUIRED_MAP_CACHE_TTL_S = 5 * 60;
+export const QNR_REQUIRED_MAP_TIMEOUT_MS = 3000;
+export const PNS_JWT_LIFETIME_S = 6 * 60 * 60;
+export const LIS_TEST_RESULT_INFO_GRPC = 'LIS_TEST_RESULT_INFO_GRPC';
+
+export interface QnrRequiredMapLike {
+  has_hormone_questionnaire?: boolean;
+}
+
+export interface PnsJwtIds {
+  patient_id?: number | string | null;
+  customer_id?: number | string | null;
+  clinic_id?: number | string | null;
+}
+
+export interface PnsJwtClaims {
+  patient_id: number | string | null;
+  customer_id: number | string | null;
+  clinic_id: number | string | null;
+  role: string;
+  internal_user_role: string;
+  iat: number;
+  exp: number;
+}
+
+interface TestResultInfoGrpc {
+  getTestsResultsRelatedData(req: {
+    sampleId: number;
+  }): Observable<{ testInfo?: { testId: number; status?: string }[] }>;
+}
+
+export interface ResolveOptions<T> {
+  /** Name of the value, used in the shadow log line. */
+  name: string;
+  sampleId: string;
+  /** The LIS-Sample HTTP path (today's behaviour). */
+  old: () => Promise<T>;
+  /** The direct-source path. */
+  direct: () => Promise<T>;
+  equals?: (a: T, b: T) => boolean;
+  /** How to render a value in the shadow log (never log secrets). */
+  describe?: (value: T) => unknown;
+  /**
+   * In `direct` mode, the value to answer with when the direct path throws.
+   * Omitted: the error propagates.
+   */
+  onDirectError?: (error: unknown) => T;
+}
+
+@Injectable()
+export class LisSampleDirectService implements OnModuleInit {
+  private readonly logger = new Logger(LisSampleDirectService.name);
+  private testResultInfoGrpc: TestResultInfoGrpc | null = null;
+
+  constructor(
+    @Inject(CACHE_MANAGER)
+    private readonly cacheManager: Cache,
+    @Inject('AUTH_JWT_SECRET')
+    private readonly authJwtSecret: string,
+    @Optional()
+    @Inject(LIS_TEST_RESULT_INFO_GRPC)
+    private readonly testResultInfoClient?: ClientGrpc,
+  ) {}
+
+  onModuleInit() {
+    this.testResultInfoGrpc =
+      this.testResultInfoClient?.getService<TestResultInfoGrpc>(
+        'TestResultInfoGrpcService',
+      ) ?? null;
+  }
+
+  /**
+   * Run the old and/or direct path according to SHIPPING_LIS_SAMPLE_MODE.
+   * In shadow mode the answer is always the old value (or the old error).
+   */
+  async resolve<T>(opts: ResolveOptions<T>): Promise<T> {
+    const mode = resolveLisSampleMode();
+
+    if (mode === 'http') {
+      return opts.old();
+    }
+
+    if (mode === 'direct') {
+      try {
+        return await opts.direct();
+      } catch (error) {
+        if (!opts.onDirectError) {
+          throw error;
+        }
+        this.logger.warn(
+          `[VP-18796] ${opts.name} direct path failed for sample ${
+            opts.sampleId
+          }, using fallback: ${
+            error instanceof Error ? error.message : String(error)
+          }`,
+        );
+        return opts.onDirectError(error);
+      }
+    }
+
+    const [oldSide, newSide] = await Promise.all([
+      runSide(opts.old),
+      runSide(opts.direct),
+    ]);
+    const outcome: ShadowOutcome = compareShadow(oldSide, newSide, opts.equals);
+    const describe = opts.describe ?? ((value: T) => value);
+    this.logger.log(
+      JSON.stringify({
+        event: 'lis_sample_shadow',
+        name: opts.name,
+        sample_id: opts.sampleId,
+        outcome,
+        old_ms: oldSide.ms,
+        new_ms: newSide.ms,
+        old_value: oldSide.ok ? describe(oldSide.value as T) : undefined,
+        new_value: newSide.ok ? describe(newSide.value as T) : undefined,
+        old_reason: oldSide.reason,
+        new_reason: newSide.reason,
+      }),
+    );
+
+    if (!oldSide.ok) {
+      throw oldSide.error;
+    }
+    return oldSide.value as T;
+  }
+
+  /**
+   * `contains_hormones` as LIS-Sample computes it: order-service
+   * questionnaire-required map, `has_hormone_questionnaire`, cached per sample
+   * for five minutes. Throws when the map cannot be fetched; callers decide the
+   * fallback (LIS-Sample answered `false`).
+   */
+  async containsHormones(sampleId: string): Promise<boolean> {
+    const key = redisKey(`lis-sample-direct:qnr-required-map:${sampleId}`);
+    let map: QnrRequiredMapLike | null | undefined;
+    try {
+      map = await this.cacheManager.get<QnrRequiredMapLike>(key);
+    } catch (error) {
+      this.logger.warn(
+        `[VP-18796] qnr map cache read failed for sample ${sampleId}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+    }
+
+    if (map === undefined || map === null) {
+      map = await this.fetchQnrRequiredMap(sampleId);
+      try {
+        await this.cacheManager.set(key, map, {
+          ttl: QNR_REQUIRED_MAP_CACHE_TTL_S,
+        });
+      } catch (error) {
+        this.logger.warn(
+          `[VP-18796] qnr map cache write failed for sample ${sampleId}: ${
+            error instanceof Error ? error.message : String(error)
+          }`,
+        );
+      }
+    }
+
+    return map?.has_hormone_questionnaire === true;
+  }
+
+  /**
+   * Same route and credentials as OrdersService.retrieveQnrRequiredMap, plus
+   * the 3 s timeout LIS-Sample applied. Kept here so the direct path has a
+   * single seam to stub in tests.
+   */
+  protected async fetchQnrRequiredMap(
+    sampleId: string,
+  ): Promise<QnrRequiredMapLike> {
+    const url = `${process.env.LIS_ORDER_HTTP_URL}orderTest/getQuestionnaireRequiredMap?sampleId=${sampleId}`;
+    const oauth2Token = await getOAuth2Token();
+    const authorization = oauth2Token ?? `Bearer ${process.env.LIS_TOKEN}`;
+    const res = await axios.get<QnrRequiredMapLike>(url, {
+      headers: { Authorization: authorization },
+      timeout: QNR_REQUIRED_MAP_TIMEOUT_MS,
+    });
+    if (res.status !== 200 || !res.data) {
+      throw new Error(
+        `getQuestionnaireRequiredMap returned ${res.status} for sample ${sampleId}`,
+      );
+    }
+    return res.data;
+  }
+
+  /**
+   * True when any hormone-related test has result status `approved`, read from
+   * results-grpc directly. LIS-Sample's `/tests` merged the same statuses over
+   * the ordered tests; for a test reported more than once the last entry wins,
+   * as in LIS-Sample. Throws on gRPC failure.
+   */
+  async hormoneTestApproved(sampleId: string): Promise<boolean> {
+    if (!this.testResultInfoGrpc) {
+      throw new Error(`${LIS_TEST_RESULT_INFO_GRPC} client is not configured`);
+    }
+    const res = await lastValueFrom(
+      this.testResultInfoGrpc.getTestsResultsRelatedData({
+        sampleId: Number(sampleId),
+      }),
+    );
+    const latestStatus = new Map<number, string | undefined>();
+    for (const test of res?.testInfo ?? []) {
+      latestStatus.set(Number(test.testId), test.status);
+    }
+    for (const [testId, status] of latestStatus) {
+      if (
+        HORMONE_RELATED_LAB_TEST_IDS.includes(testId) &&
+        status === 'approved'
+      ) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * The token LIS-Sample's `GET /patients/pns-jwt` minted: HS256, six hours,
+   * ids `|| null`, signed with AUTH_JWT_SECRET (byte-identical between the two
+   * services per environment).
+   */
+  mintPnsJwt(ids: PnsJwtIds, now: number = Date.now()): string {
+    const iat = Math.floor(now / 1000);
+    const payload: PnsJwtClaims = {
+      patient_id: ids.patient_id || null,
+      customer_id: ids.customer_id || null,
+      clinic_id: ids.clinic_id || null,
+      role: 'patient',
+      internal_user_role: 'admin',
+      iat,
+      exp: iat + PNS_JWT_LIFETIME_S,
+    };
+    return jwt.sign(payload, this.authJwtSecret);
+  }
+
+  /** Claims that identify a PNS token, for the shadow log (never the token). */
+  describePnsJwt(
+    token: string,
+  ): Partial<PnsJwtClaims> & { lifetime_s?: number } {
+    const claims = jwt.decode(token) as PnsJwtClaims | null;
+    if (!claims) {
+      return {};
+    }
+    return {
+      patient_id: claims.patient_id,
+      customer_id: claims.customer_id,
+      clinic_id: claims.clinic_id,
+      role: claims.role,
+      internal_user_role: claims.internal_user_role,
+      lifetime_s: claims.exp - claims.iat,
+    };
+  }
+
+  /** Two PNS tokens are equal when their identity claims and lifetime match. */
+  pnsJwtClaimsEqual(a: string, b: string): boolean {
+    const x = this.describePnsJwt(a);
+    const y = this.describePnsJwt(b);
+    return (
+      Object.keys(x).length > 0 &&
+      x.patient_id === y.patient_id &&
+      x.customer_id === y.customer_id &&
+      x.clinic_id === y.clinic_id &&
+      x.role === y.role &&
+      x.internal_user_role === y.internal_user_role &&
+      x.lifetime_s === y.lifetime_s
+    );
+  }
+}
