+/**
+ * VP-18796: how LIS-Shipping obtains the three values it used to read from
+ * LIS-Sample over HTTP (contains_hormones, hormone test approved, pns_jwt).
+ *
+ * - `http`   (default) call LIS-Sample as before.
+ * - `shadow` call LIS-Sample AND the direct sources, answer with the
+ *            LIS-Sample value, log a per-call comparison.
+ * - `direct` read the sources directly, LIS-Sample is not called.
+ *
+ * Read from the environment on every call so a ConfigMap change plus a
+ * rolling restart is the whole switch; anything unrecognised is `http`.
+ */
+export const LIS_SAMPLE_MODE_ENV = 'SHIPPING_LIS_SAMPLE_MODE';
+
+export type LisSampleMode = 'http' | 'shadow' | 'direct';
+
+export function resolveLisSampleMode(
+  raw: string | undefined = process.env[LIS_SAMPLE_MODE_ENV],
+): LisSampleMode {
+  const value = (raw ?? '').trim().toLowerCase();
+  if (value === 'shadow' || value === 'direct') {
+    return value;
+  }
+  return 'http';
+}
