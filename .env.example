# Claude API (optional if using `claude /login`)
# Auth priority: 1) macOS Keychain (Claude Code /login)  2) ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=your_api_key_here

# Jira
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-token-here

# Git
GIT_USER_NAME="LIS Code Agent"
GIT_USER_EMAIL="lis-code-agent@example.com"

# Paths
REPOS_BASE_PATH=/Users/hung.l/src
AGENT_BRANCH_PREFIX_FEATURE=feature/leo
AGENT_BRANCH_PREFIX_BUGFIX=bugfix/leo

# Schedule
SCAN_INTERVAL_HOURS=12

# Ticket Watch morning report (DailyJob/ticket_watch) — SMTP for send_report.py
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=you@gmail.com
REPORT_SMTP_PASSWORD=gmail-app-password
REPORT_EMAIL_TO=you@gmail.com
